# IACPaaS: либо API-ключ, либо логин/пароль
IACPAAS_API_KEY=
IACPAAS_USERNAME=
IACPAAS_PASSWORD=
IACPAAS_ALLOW_WRITE=false
IACPAAS_CATALOG=catalog.txt

# LLM для standalone-агента и веб-чата
IACPAAS_AGENT_API_KEY=
IACPAAS_AGENT_MODEL=
IACPAAS_AGENT_BASE_URL=
# Пусто = не передавать; 0 для детерминированности
IACPAAS_AGENT_TEMPERATURE=0
# Пусто = не передавать; low/medium/high только для поддерживающих моделей
IACPAAS_AGENT_REASONING_EFFORT=
IACPAAS_AGENT_CONTEXT_TOKENS=1000000
