IACPAAS_BASE_URL=https://iacpaas.dvo.ru
# Либо ключ от администратора, либо логин/пароль (JWT через /api/signin)
IACPAAS_API_KEY=
IACPAAS_USERNAME=
IACPAAS_PASSWORD=
IACPAAS_TIMEOUT=60
IACPAAS_ALLOW_WRITE=false
# stdio - для VS Code, http - Streamable HTTP на HOST:PORT
IACPAAS_TRANSPORT=stdio
IACPAAS_HOST=127.0.0.1
IACPAAS_PORT=8000
